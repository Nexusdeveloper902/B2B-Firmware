/**
 * secrets.camera.h.example — committed TEMPLATE for the CAMERA station.
 * secrets.camera.h.example — PLANTILLA comprometida para la estación de CÁMARA.
 *
 * The camera station (env `esp32cam`) has its OWN secrets file, separate
 * from the reader's `secrets.h` — the two devices are different backend
 * identities (different READER_API_KEY rows). / La cámara (entorno
 * `esp32cam`) tiene su PROPIO archivo de secretos, separado del
 * `secrets.h` del lector — son identidades distintas en el backend.
 *
 * Usage / Uso:
 *   1. Copy this file to include/secrets.camera.h
 *      ( cp include/secrets.camera.h.example include/secrets.camera.h )
 *   2. Fill in the real values.
 *   3. Build & flash. include/secrets.camera.h is gitignored and is NEVER
 *      committed. / Nunca se sube al repositorio.
 *
 * Which reader key? The B2B-Core DemoSeeder prints every reader api_key
 * when seeding (./run setup). Use a RECYCLING reader key — with the demo
 * seed there is exactly one (`Demo Reader — Recycling`).
 * ¿Qué clave? El DemoSeeder imprime todos los api_key (./run setup). Usa
 * una clave de lector de RECICLAJE.
 */
#pragma once

// Wi-Fi access point the camera station connects to / Punto de acceso Wi-Fi
#define WIFI_SSID      "YOUR_WIFI_SSID"
#define WIFI_PASSWORD  "YOUR_WIFI_PASSWORD"

// Backend base URL (B2B-Core). No trailing slash. BOOT FALLBACK ONLY:
// at boot the station first queries _pulse._tcp.local (advertised by
// `./run serve`) and uses the discovered address; this value applies only
// when discovery finds nothing, and is replaced at runtime on rediscovery.
// Must be reachable from the camera's Wi-Fi — a LAN IP, e.g.
// "http://192.168.1.50:8000" (start it with `./run serve --host`).
// NEVER "localhost" here.
// / URL base del backend. Sin barra final. SOLO RESERVA inicial: al
// arrancar la estación primero consulta _pulse._tcp.local (anunciado por
// `./run serve`); este valor solo se usa si no hay descubrimiento, y se
// reemplaza en caliente. Alcanzable por Wi-Fi (IP de LAN, NUNCA localhost).
#define API_BASE_URL   "http://192.168.1.50:8000"  // LAN IP of the machine running B2B-Core (./run serve --host) — NEVER "localhost": on the ESP32 that is the board itself

// Static Bearer key of THIS camera station, as printed by the B2B-Core
// seeder (a recycling reader key). The key IS the station identity.
// / Clave Bearer estática de ESTA cámara (clave de lector de reciclaje).
#define READER_API_KEY "00000000000000000000000000000000"

// HCE pre-shared key (HCE integration): same contract as the reader's
// secrets.h — HMAC-SHA256(HCE_SECRET, credId || nonce) over the phone's
// application-level credential. MUST match the Android app's secret
// (B2B-App/pulse-credential). DEVELOPMENT-ONLY shared key (see
// docs/HCE_PROTOCOL.md). Never log it, never commit this file.
#define HCE_SECRET   "dev-only-prototype-secret-001"

// The CAMERA STATION does have a mode console (password + Enter toggles
// operation/pairing on the serial monitor) — set it, don't ship the
// placeholder. It must not collide with the command grammar (c / a <uid> /
// e <id>), or that line is consumed as the command first.
// / La estación SÍ tiene consola de modo: cámbiala, no dejes el marcador.
#define MODE_PASSWORD  "CHANGE-ME-MODE-PW"
