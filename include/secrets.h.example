/**
 * secrets.h.example — committed TEMPLATE for real credentials.
 * secrets.h.example — PLANTILLA comprometida para credenciales reales.
 *
 * Usage / Uso:
 *   1. Copy this file to include/secrets.h
 *      ( cp include/secrets.h.example include/secrets.h )
 *   2. Fill in the real values.
 *   3. Build & flash. include/secrets.h is gitignored and is NEVER committed.
 *
 * Which reader key? The B2B-Core DemoSeeder prints every reader api_key to
 * the console when seeding (./run setup). Use the key of the reader this
 * physical device represents.
 * ¿Qué clave de lector? El DemoSeeder de B2B-Core imprime todos los
 * api_key de lectores al ejecutar ./run setup. Usa la clave del lector que
 * representa este dispositivo físico.
 */
#pragma once

// Wi-Fi access point the reader connects to / Punto de acceso Wi-Fi
#define WIFI_SSID      "YOUR_WIFI_SSID"
#define WIFI_PASSWORD  "YOUR_WIFI_PASSWORD"

// Backend base URL (B2B-Core). No trailing slash.
// URL base del backend (B2B-Core). Sin barra final.
// Local dev example: "http://192.168.1.50:8000" (php artisan serve --host)
#define API_BASE_URL   "http://localhost:8000"

// Static Bearer key of THIS reader, as printed by the B2B-Core seeder.
// Clave Bearer estática de ESTE lector, impresa por el seeder de B2B-Core.
// The key IS the reader identity — the backend never trusts a client-
// supplied reader id. / La clave ES la identidad del lector.
#define READER_API_KEY "00000000000000000000000000000000"
